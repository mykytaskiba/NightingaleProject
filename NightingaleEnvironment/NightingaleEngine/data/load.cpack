@clearlog
@enablelog true

shader_load main_shader data/shader/main.vert data/shader/main.frag
@verify

shader_load anim_shader data/shader/animated.vert data/shader/main.frag
@verify

shader_load unlit_shader data/shader/main.vert data/shader/unlit.frag
@verify

shader_load line_shader data/shader/line.vert data/shader/line.frag
@verify

load_scale 0.01
mesh_load plane_mesh data/core/plane.fbx
@verify

create cameracontroller

//cpack data/load_simple_scene.cpack

cpack data/load_project_two.cpack
cpack data/load_project_one.cpack

//@undefine_all

@enablelog false
