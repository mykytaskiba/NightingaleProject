@clearlog
@enablelog true

shader_load main_shader data/core/shader/main.vert data/core/shader/main.frag
@verify

shader_load anim_shader data/core/shader/animated.vert data/core/shader/main.frag
@verify

shader_load unlit_shader data/core/shader/main.vert data/core/shader/unlit.frag
@verify

shader_load line_shader data/core/shader/line.vert data/core/shader/line.frag
@verify

load_scale 0.01

mesh_load sphere_mesh data/core/sphere.fbx
@verify

@enablelog false
