
loader_scale = 0.01
load_mesh cube_mesh data/core/cube.fbx
@verify
load_mesh sphere_mesh data/core/sphere.fbx
@verify
load_mesh smooth_sphere_mesh data/core/smooth_sphere.fbx
@verify

create_gameobject gameobject
attach_rendermesh cube_mesh
setposition 0 -8 0
setcolor 0.8 0.2 0.2

create_gameobject gameobject
attach_rendermesh sphere_mesh
setposition -4 -8 0
setcolor 0.2 0.8 0.2

create_gameobject gameobject
attach_rendermesh smooth_sphere_mesh
setposition 4 -8 0
setcolor 0.2 0.2 0.8
