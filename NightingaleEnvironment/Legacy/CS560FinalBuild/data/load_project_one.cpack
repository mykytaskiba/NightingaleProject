load_scale 0.05
skeleton_load character data/character_ybot.fbx
@verify

animation_load ybot_walk data/anim_walk_ybot.fbx
@verify

animation_load ybot_idle data/anim_idle_ybot.fbx
@verify

animation_load ybot_dance data/anim_dance_ybot.fbx
@verify

animation_load ybot_kickup data/anim_kickup_ybot.fbx
@verify

animation_load ybot_kick data/anim_kick_ybot.fbx
@verify

animation_load ybot_throw data/anim_throw_ybot.fbx
@verify

//Sphere needed for nodes
load_scale 0.01
mesh_load bone_mesh data/core/sphere.fbx
@verify

create project1gameobject
attach_animatedmesh character
setposition 0 -12 0